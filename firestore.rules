rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCounter(val) {
      return val is number && val >= 0 && val <= 10000000;
    }

    // Pillar 2: Validation Blueprint for UserProgress
    function isValidUserProgress(data) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'totalPoints',
        'starsCollected',
        'treasuresCollected',
        'foodEaten',
        'furthestDistance',
        'highestChapter',
        'smoothStones',
        'lostTrinkets',
        'shimmeringScales',
        'riverPearls',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'displayName',
        'totalPoints',
        'starsCollected',
        'treasuresCollected',
        'foodEaten',
        'furthestDistance',
        'highestChapter',
        'smoothStones',
        'lostTrinkets',
        'shimmeringScales',
        'riverPearls',
        'updatedAt'
      ]) &&
      data.uid is string &&
      data.uid == request.auth.uid &&
      isValidId(data.uid) &&
      data.displayName is string &&
      data.displayName.size() >= 1 &&
      data.displayName.size() <= 100 &&
      isValidCounter(data.totalPoints) &&
      isValidCounter(data.starsCollected) &&
      isValidCounter(data.treasuresCollected) &&
      isValidCounter(data.foodEaten) &&
      isValidCounter(data.furthestDistance) &&
      data.highestChapter is number &&
      data.highestChapter >= 1 &&
      data.highestChapter <= 5 &&
      isValidCounter(data.smoothStones) &&
      isValidCounter(data.lostTrinkets) &&
      isValidCounter(data.shimmeringScales) &&
      isValidCounter(data.riverPearls) &&
      data.updatedAt == request.time;
    }

    // /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProgress(incoming());

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProgress(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'totalPoints',
          'starsCollected',
          'treasuresCollected',
          'foodEaten',
          'furthestDistance',
          'highestChapter',
          'smoothStones',
          'lostTrinkets',
          'shimmeringScales',
          'riverPearls',
          'updatedAt'
        ]);

      allow delete: if false;
    }
  }
}
