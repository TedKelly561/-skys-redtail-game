rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCounter(val) {
      return val is number && val >= 0 && val <= 10000000;
    }

    // Pillar 2: Validation Blueprint for UserProgress
    function isValidUserProgress(data) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'totalPoints',
        'starsCollected',
        'treasuresCollected',
        'foodEaten',
        'furthestDistance',
        'highestChapter',
        'smoothStones',
        'lostTrinkets',
        'shimmeringScales',
        'riverPearls',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'displayName',
        'totalPoints',
        'starsCollected',
        'treasuresCollected',
        'foodEaten',
        'furthestDistance',
        'highestChapter',
        'smoothStones',
        'lostTrinkets',
        'shimmeringScales',
        'riverPearls',
        'updatedAt'
      ]) &&
      data.uid is string &&
      data.uid == request.auth.uid &&
      isValidId(data.uid) &&
      data.displayName is string &&
      data.displayName.size() >= 1 &&
      data.displayName.size() <= 100 &&
      isValidCounter(data.totalPoints) &&
      isValidCounter(data.starsCollected) &&
      isValidCounter(data.treasuresCollected) &&
      isValidCounter(data.foodEaten) &&
      isValidCounter(data.furthestDistance) &&
      data.highestChapter is number &&
      data.highestChapter >= 1 &&
      data.highestChapter <= 5 &&
      isValidCounter(data.smoothStones) &&
      isValidCounter(data.lostTrinkets) &&
      isValidCounter(data.shimmeringScales) &&
      isValidCounter(data.riverPearls) &&
      data.updatedAt == request.time;
    }

    // Pillar 3: Validation Blueprint for UserExtras (friends, outfits, fish house, buddy)
    function isShortString(val, max) {
      return val is string && val.size() <= max;
    }

    function isShortList(val, max) {
      return val is list && val.size() <= max;
    }

    function isValidUserExtras(data) {
      return data.keys().hasAll([
        'uid', 'friends', 'closetOwned', 'closetSpent', 'outfitHat', 'outfitGlasses', 'outfitColor',
        'houseOwned', 'houseSpent', 'lakeUnlocked', 'buddyName', 'buddyColor', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'friends', 'closetOwned', 'closetSpent', 'outfitHat', 'outfitGlasses', 'outfitColor',
        'houseOwned', 'houseSpent', 'lakeUnlocked', 'buddyName', 'buddyColor', 'updatedAt'
      ]) &&
      data.uid is string &&
      data.uid == request.auth.uid &&
      isShortList(data.friends, 40) &&
      isShortList(data.closetOwned, 60) &&
      isValidCounter(data.closetSpent) &&
      isShortString(data.outfitHat, 40) &&
      isShortString(data.outfitGlasses, 40) &&
      isShortString(data.outfitColor, 40) &&
      isShortList(data.houseOwned, 20) &&
      isValidCounter(data.houseSpent) &&
      data.lakeUnlocked is bool &&
      isShortString(data.buddyName, 20) &&
      isShortString(data.buddyColor, 9) &&
      data.updatedAt == request.time;
    }

    // Pillar 4: Backups of the other players on the device (a cousin, a friend). Each slot is
    // one player's saved game as text; empty when unused.
    function isValidPlayerBackups(data) {
      return data.keys().hasAll(['uid', 'p1', 'p2', 'p3', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'p1', 'p2', 'p3', 'updatedAt']) &&
        data.uid is string &&
        data.uid == request.auth.uid &&
        isShortString(data.p1, 100000) &&
        isShortString(data.p2, 100000) &&
        isShortString(data.p3, 100000) &&
        data.updatedAt == request.time;
    }

    // /playerBackups/{userId}
    match /playerBackups/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidPlayerBackups(incoming());
      allow update: if isOwner(userId) && isValidId(userId) &&
        isValidPlayerBackups(incoming()) &&
        incoming().uid == existing().uid;
      allow delete: if false;
    }

    // /userExtras/{userId}
    match /userExtras/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserExtras(incoming());
      allow update: if isOwner(userId) && isValidId(userId) &&
        isValidUserExtras(incoming()) &&
        incoming().uid == existing().uid;
      allow delete: if false;
    }

    // /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProgress(incoming());

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProgress(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'totalPoints',
          'starsCollected',
          'treasuresCollected',
          'foodEaten',
          'furthestDistance',
          'highestChapter',
          'smoothStones',
          'lostTrinkets',
          'shimmeringScales',
          'riverPearls',
          'updatedAt'
        ]);

      allow delete: if false;
    }
  }
}
